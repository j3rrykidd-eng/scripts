local function ShowAnnouncement(data)
    if type(data) ~= "table" or not data.id or not data.message then
        return
    end

    if SeenAnnouncementId == tostring(data.id) then
        return
    end

    local createdAt = tonumber(data.createdAt) or 0
    if createdAt > 0 and math.abs(os.time() - createdAt) > 15 then
        return
    end

    SeenAnnouncementId = tostring(data.id)
    AnnouncementToken += 1
    local token = AnnouncementToken

    AnnouncementText.Text = "Script Owner " .. tostring(data.owner or "J3RRYKIDD") .. ": " .. tostring(data.message)

    AnnouncementFrame.Visible = true
    AnnouncementFrame.BackgroundTransparency = 1
    AnnouncementText.TextTransparency = 1

    Tween(
        AnnouncementFrame,
        0.35,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out,
        {BackgroundTransparency = 0.05}
    )

    Tween(
        AnnouncementText,
        0.35,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out,
        {TextTransparency = 0}
    )

    task.delay(15, function()
        if token ~= AnnouncementToken then
            return
        end

        local bgTween = Tween(
            AnnouncementFrame,
            0.45,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out,
            {BackgroundTransparency = 1}
        )

        Tween(
            AnnouncementText,
            0.45,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out,
            {TextTransparency = 1}
        )

        bgTween.Completed:Wait()

        if token == AnnouncementToken then
            AnnouncementFrame.Visible = false
        end
    end)
end

local function ProcessOwnerCommand(command)
    if type(command) ~= "table" or not command.type then
        return
    end

    if command.type == "kick" then
        local reason = tostring(command.reason or "Kicked by script owner")
        LocalPlayer:Kick(reason)
        return
    end

    if command.type == "bring_server" or command.type == "bring" then
        local targetJobId = tostring(command.jobId or "")

        if targetJobId == "" then
            return
        end

        if targetJobId == tostring(JobId) then
            if command.type == "bring" and command.position and RootPart then
                RootPart.CFrame = CFrame.new(
                    tonumber(command.position.x) or RootPart.Position.X,
                    tonumber(command.position.y) or RootPart.Position.Y,
                    tonumber(command.position.z) or RootPart.Position.Z
                )
            end
            return
        end

        local teleportData = nil

        if command.type == "bring" and command.position then
            teleportData = {
                slapTowerOwnerBring = true,
                x = tonumber(command.position.x) or 0,
                y = tonumber(command.position.y) or 0,
                z = tonumber(command.position.z) or 0
            }
        end

        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                tonumber(command.placeId) or game.PlaceId,
                targetJobId,
                LocalPlayer,
                nil,
                teleportData
            )
        end)
    end
end

