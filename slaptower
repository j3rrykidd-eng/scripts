-- Cross-executor HTTP request adapter (PC + Mobile)
-- Tries the common request APIs used by many executors.
local function ResolveRequestFunction()
    local env = nil
    pcall(function()
        if type(getgenv) == "function" then
            env = getgenv()
        end
    end)

    local candidates = {}

    local function add(fn)
        if type(fn) == "function" then
            for _, existing in ipairs(candidates) do
                if existing == fn then
                    return
                end
            end
            table.insert(candidates, fn)
        end
    end

    if env then
        add(env.request)
        add(env.http_request)
    end

    add(rawget(_G, "request"))
    add(rawget(_G, "http_request"))

    pcall(function()
        if syn then add(syn.request) end
    end)
    pcall(function()
        if http then add(http.request) end
    end)
    pcall(function()
        if fluxus then add(fluxus.request) end
    end)
    pcall(function()
        if request then add(request) end
    end)

    if #candidates == 0 then
        return nil
    end

    return function(options)
        local lastError = "No request API succeeded"

        for _, fn in ipairs(candidates) do
            local ok, result = pcall(fn, options)
            if ok and result then
                -- Executors differ slightly in response field casing.
                if type(result) == "table" then
                    if result.Body == nil and result.body ~= nil then
                        result.Body = result.body
                    end
                    if result.StatusCode == nil and result.Status ~= nil then
                        result.StatusCode = result.Status
                    end
                end
                return result
            end
            if not ok then
                lastError = tostring(result)
            end
        end

        error(lastError)
    end
end

