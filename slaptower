-- Strong but smooth open/close animation.
local function SetGuiOpen(open)
    if GuiAnimating then
        return
    end

    GuiOpen = open
    GuiAnimating = true

    if open then
        MainFrame.Visible = true
        BubbleButton.Visible = false

        -- Re-open exactly where the GUI was last dragged to.
        MainFrame.Position = LastGuiPosition
        GuiScale.Scale = 0.86

        -- Tiny upward settle instead of jumping to the center.
        local targetPosition = LastGuiPosition
        local startPosition = UDim2.new(
            targetPosition.X.Scale,
            targetPosition.X.Offset,
            targetPosition.Y.Scale,
            targetPosition.Y.Offset + 12
        )
        MainFrame.Position = startPosition

        local move = Tween(
            MainFrame,
            0.30,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out,
            {Position = targetPosition}
        )

        local scale = Tween(
            GuiScale,
            0.30,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out,
            {Scale = 1}
        )

        move.Completed:Connect(function()
            LastGuiPosition = MainFrame.Position
            GuiAnimating = false
        end)
    else
        -- Save the exact position before closing.
        LastGuiPosition = MainFrame.Position

        local targetPosition = UDim2.new(
            LastGuiPosition.X.Scale,
            LastGuiPosition.X.Offset,
            LastGuiPosition.Y.Scale,
            LastGuiPosition.Y.Offset + 12
        )

        local move = Tween(
            MainFrame,
            0.24,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.In,
            {Position = targetPosition}
        )

        local scale = Tween(
            GuiScale,
            0.24,
            Enum.EasingStyle.Quint,
