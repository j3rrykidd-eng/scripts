        ServerRefreshRunning = false
    end)
end

local function OwnerRequest(action, extra)
    if not IsOwner or not RequestFunction then
        return nil
    end

    extra = extra or {}

    local params = {
        action = action,
        username = LocalPlayer.Name,
        jobId = JobId
    }

    for key, value in pairs(extra) do
        params[key] = value
    end

    local query = {}

    for key, value in pairs(params) do
        table.insert(
            query,
            HttpService:UrlEncode(tostring(key)) .. "=" .. HttpService:UrlEncode(tostring(value))
        )
    end

    local ok, response = pcall(function()
        return RequestFunction({
            Url = ServerUrl .. "?" .. table.concat(query, "&"),
            Method = "GET"
        })
    end)

    if not ok or not response or not response.Body then
        return nil
    end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodeOk or not data then
        return nil
    end

    return data
end

