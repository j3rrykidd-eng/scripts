local TeleportToSelected = nil
local TeleportToLoaded = false

local function RenderTeleportPlayers()
    for _, child in ipairs(TeleportToList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local order = 1
    local foundSelected = false

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local targetPlayer = player
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, -6, 0, IsMobile and 28 or 30)
            button.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
            button.Text = targetPlayer.Name
            button.TextColor3 = Color3.fromRGB(235, 235, 240)
            button.TextSize = TextSize
            button.Font = Enum.Font.Gotham
            button.LayoutOrder = order
            button.Parent = TeleportToList
            ApplyStyle(button, 6)

            button.MouseButton1Click:Connect(function()
                TeleportToSelected = targetPlayer.Name
                TeleportToButton.Text = "Teleport To: " .. targetPlayer.Name
                TeleportToList.Visible = false
            end)

            if TeleportToSelected and string.lower(TeleportToSelected) == string.lower(targetPlayer.Name) then
                foundSelected = true
            end

            order += 1
        end
    end

    if not foundSelected then
        TeleportToSelected = nil
        TeleportToButton.Text = "Teleport To: select player"
    end

    TeleportToList.CanvasSize = UDim2.new(0, 0, 0, TeleportToLayout.AbsoluteContentSize.Y + 8)
    TeleportToLoaded = true

    if order == 1 then
        TeleportToButton.Text = "Teleport To: no other players"
    end
end

local function TeleportToSelectedPlayer()
    if not TeleportToSelected or TeleportToSelected == "" then
        TeleportToButton.Text = "Teleport To: select player"
        return
    end

    local target = Players:FindFirstChild(TeleportToSelected)
    local targetRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")

    if targetRoot and RootPart then
        RootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
        TeleportToButton.Text = "Teleported to " .. target.Name
        task.delay(1.2, function()
            if TeleportToSelected then
                TeleportToButton.Text = "Teleport To: " .. TeleportToSelected
            end
        end)
    else
        TeleportToButton.Text = "Target not available"
        task.delay(1.2, function()
            if TeleportToSelected then
                TeleportToButton.Text = "Teleport To: " .. TeleportToSelected
            else
                TeleportToButton.Text = "Teleport To: select player"
            end
        end)
    end
end

TeleportToButton.MouseButton1Click:Connect(function()
    if not TeleportToLoaded then
        RenderTeleportPlayers()
        return
    end

    if TeleportToSelected then
        TeleportToSelectedPlayer()
    else
        TeleportToList.Visible = not TeleportToList.Visible
    end
end)

Players.PlayerAdded:Connect(function()
    if CurrentTab == "Main" then
        task.defer(RenderTeleportPlayers)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if TeleportToSelected and player.Name == TeleportToSelected then
        TeleportToSelected = nil
    end
    task.defer(RenderTeleportPlayers)
end)

task.spawn(function()
