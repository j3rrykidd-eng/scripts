-- Heartbeat/session settings
local HeartbeatInterval = 10
local SessionToken = HttpService:GenerateGUID(false)
local HeartbeatConnection = nil
local HeartbeatAccumulator = HeartbeatInterval
local HeartbeatStopped = false

local function SendPing(action)
    action = action or "ping"
    if HeartbeatStopped or not RequestFunction then
        return false
    end

    -- If the executor keeps running while Roblox leaves the current DataModel,
    -- stop sending heartbeats. The captured JobId also prevents carrying a
    -- previous server session into a different Roblox server.
    if game.JobId ~= "" and game.JobId ~= JobId then
        HeartbeatStopped = true
        return false
    end

    if not LocalPlayer or not LocalPlayer.Parent then
        HeartbeatStopped = true
        return false
    end

    local pingUrl = string.format(
        "%s?action=%s&username=%s&jobId=%s&sessionToken=%s",
        ServerUrl,
        HttpService:UrlEncode(action),
        HttpService:UrlEncode(LocalPlayer.Name),
        HttpService:UrlEncode(JobId),
        HttpService:UrlEncode(SessionToken)
    )

    local ok, response = pcall(function()
        return RequestFunction({
            Url = pingUrl,
            Method = "GET"
        })
    end)

    if not ok or not response or not response.Body then
        return false
    end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodeOk or not data or not data.success then
        if data and data.error == "Invalid session" then
            HeartbeatStopped = true
        end
        return false
    end

    if data.users then
        RegisteredUsers = data.users
    end

    if data.servers then
        RegisteredServers = data.servers
    end

    if data.owner ~= nil then
        IsOwner = data.owner == true
    end

    if data.commands then
        PendingCommands = data.commands
    end

    if data.announcement then
        PendingAnnouncement = data.announcement
    end

    if ServerListChanged then
        pcall(ServerListChanged)
    end

    return true
end

-- Initial registration immediately. Subsequent heartbeats are driven by
-- RunService.Heartbeat instead of a permanent task.wait/thread loop.
SendPing("start")
HeartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if HeartbeatStopped then
        if HeartbeatConnection then
            HeartbeatConnection:Disconnect()
            HeartbeatConnection = nil
        end
        return
    end

    HeartbeatAccumulator += deltaTime
    if HeartbeatAccumulator >= HeartbeatInterval then
        HeartbeatAccumulator = 0
        if not SendPing() and (not LocalPlayer or not LocalPlayer.Parent) then
            HeartbeatStopped = true
        end
    end
end)

