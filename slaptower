local function RenderOwnerUsers(users)
    ClearOwnerUsers()

    if type(users) ~= "table" then
        users = {}
    end

    local order = 1
    local foundSelected = false

    for _, targetName in ipairs(users) do
        targetName = tostring(targetName)

        if string.lower(targetName) ~= string.lower(LocalPlayer.Name) then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -8, 0, ButtonHeight)
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
            b.Text = targetName
            b.TextColor3 = Color3.fromRGB(235, 235, 240)
            b.TextSize = TextSize
            b.Font = Enum.Font.GothamBold
            b.LayoutOrder = order
            b.Parent = OwnerUserList
            ApplyStyle(b, 6)

            b.MouseButton1Click:Connect(function()
                OwnerSelectedUser = targetName
                OwnerUserButton.Text = targetName
                OwnerUserList.Visible = false
                OwnerKickButton.Text = "Kick"
                OwnerKickReason.Visible = false
            end)

            if OwnerSelectedUser and string.lower(OwnerSelectedUser) == string.lower(targetName) then
                foundSelected = true
            end

            order += 1
        end
    end

    if not foundSelected then
        OwnerSelectedUser = nil
        OwnerUserButton.Text = "Select User"
    end

    OwnerUserList.CanvasSize = UDim2.new(
        0,
        0,
        0,
        OwnerUserLayout.AbsoluteContentSize.Y + 8
    )

    OwnerUsersLoaded = true

    if order == 1 then
        OwnerUserButton.Text = "No active users"
    end
end

