local function RenderServers()
    ClearServerEntries()
    local order = 3
    local shown = 0
    for _, server in ipairs(RegisteredServers) do
        local jid = server.jobId or server.JobId or server.id or server.ID
        if jid and tostring(jid) ~= tostring(JobId) then
            CreateServerEntry(server, order)
            order += 1
            shown += 1
        end
    end
    if shown == 0 then
        LoadingLabel.Text = ServersLoaded and "No other active servers found." or "Loading servers..."
        LoadingLabel.Visible = true
    else
        LoadingLabel.Visible = false
    end
    ServersScroll.CanvasSize = UDim2.new(0, 0, 0, ServersLayout.AbsoluteContentSize.Y + 12)
end

