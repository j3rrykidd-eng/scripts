local DonationShown = true
local DonationFinished = false

local function OpenMainAfterDonation()
    if DonationFinished then
        return
    end

    DonationFinished = true
    DonationShown = false
    DonationFrame.Visible = false
    MainFrame.Visible = true
    BubbleButton.Visible = false
    GuiOpen = true
    MainFrame.Position = LastGuiPosition
    GuiScale.Scale = 0.90

    Tween(
        GuiScale,
        0.30,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out,
        {Scale = 1}
    )
end

local function ShowDonationThankYou()
    DonationTitle.Text = "Thank you!"
    DonationMessage.Text = "Thank you for donating.\nEnjoy the script ❤️"
    DonationYes.Visible = false
    DonationNo.Text = "OK"
    DonationNo.BackgroundColor3 = Color3.fromRGB(45, 180, 85)
    DonationNo.Position = UDim2.new(0, 16, 1, -(IsMobile and 42 or 46))
end

DonationNo.Activated:Connect(function()
    if not DonationShown then
        return
    end
    OpenMainAfterDonation()
end)

DonationYes.Activated:Connect(function()
    if not DonationShown then
        return
    end

    DonationYes.Text = "Opening Roblox purchase..."
    DonationYes.AutoButtonColor = false

    local ok = pcall(function()
        MarketplaceService:PromptGamePassPurchase(LocalPlayer, DONATION_GAMEPASS_ID)
    end)

    if not ok then
        DonationYes.Text = "Yes, why not? (It's cheap!)"
        DonationYes.AutoButtonColor = true
    end
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
    if player ~= LocalPlayer or gamePassId ~= DONATION_GAMEPASS_ID or not DonationShown then
        return
    end

    if wasPurchased then
        ShowDonationThankYou()
    else
        DonationYes.Text = "Yes, why not? (It's cheap!)"
        DonationYes.AutoButtonColor = true
    end
end)

task.spawn(function()
    local ownsPass = false
    local ok = pcall(function()
        ownsPass = MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, DONATION_GAMEPASS_ID)
    end)

    if ok and ownsPass and DonationShown then
        ShowDonationThankYou()
    end
end)

MainFrame.Visible = false
BubbleButton.Visible = false

