RunService.RenderStepped:Connect(function()
    if not FlyEnabled or not RootPart or not Humanoid or Humanoid.Health <= 0 then
        return
    end
    if not FlyVelocity or not FlyVelocity.Parent then
        StartFly()
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local move = Humanoid.MoveDirection
    local direction = Vector3.zero
    if move.Magnitude > 0.01 then
        -- Rebuild the joystick/WASD direction against the camera so forward always means camera-forward.
        local right = camera.CFrame.RightVector
        local look = camera.CFrame.LookVector
        local side = move:Dot(right)
        local forward = move:Dot(Vector3.new(look.X, 0, look.Z).Unit)
        direction = (right * side) + (look * forward)
        if direction.Magnitude > 0.01 then
            direction = direction.Unit
        end
    end

    FlyVelocity.Velocity = direction * (55 * FlySpeedMultiplier)

    local look = camera.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > 0.01 then
        FlyGyro.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + flatLook.Unit)
    end
end)

