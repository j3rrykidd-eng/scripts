local function ShowTab(tabName)
    if tabName ~= "Main" and tabName ~= "Servers" and tabName ~= "Teleport" and tabName ~= "Owner" then
        return
    end

    if tabName == "Owner" and not IsOwner then
        return
    end

    if TabTransitioning then
        return
    end

    if CurrentTab == tabName then
        return
    end

    TabTransitioning = true

    if tabName == "Servers" then
        ScrollingFrame.Visible = false
        ServersFrame.Visible = true
        TeleportFrame.Visible = false
        OwnerFrame.Visible = false

        AnimateTabButton(MainTabButton, false)
        AnimateTabButton(ServersTabButton, true)
        if OwnerTabButton then
            AnimateTabButton(OwnerTabButton, false)
        end

        CurrentTab = "Servers"

        if not ServersLoaded then
            ServerIntro.Visible = true
            LoadingLabel.Visible = false
            RefreshButton.Visible = false
        else
            ServerIntro.Visible = false
            RefreshButton.Visible = true
            RenderServers()
        end
    elseif tabName == "Teleport" then
        ScrollingFrame.Visible = false
        ServersFrame.Visible = false
        TeleportFrame.Visible = true
        OwnerFrame.Visible = false

        AnimateTabButton(MainTabButton, false)
        AnimateTabButton(ServersTabButton, false)
        AnimateTabButton(TeleportTabButton, true)
        if OwnerTabButton then
            AnimateTabButton(OwnerTabButton, false)
        end

        CurrentTab = "Teleport"
    elseif tabName == "Owner" then
        ScrollingFrame.Visible = false
        ServersFrame.Visible = false
        TeleportFrame.Visible = false
        OwnerFrame.Visible = true

        AnimateTabButton(MainTabButton, false)
        AnimateTabButton(ServersTabButton, false)
        AnimateTabButton(TeleportTabButton, false)
        if OwnerTabButton then
            AnimateTabButton(OwnerTabButton, true)
        end

        CurrentTab = "Owner"

        if not OwnerUsersLoaded then
            LoadOwnerUsers()
        end
    else
        ServersFrame.Visible = false
        TeleportFrame.Visible = false
        OwnerFrame.Visible = false
        ScrollingFrame.Visible = true

        AnimateTabButton(MainTabButton, true)
        AnimateTabButton(ServersTabButton, false)
        AnimateTabButton(TeleportTabButton, false)
        if OwnerTabButton then
            AnimateTabButton(OwnerTabButton, false)
        end

        CurrentTab = "Main"
    end

    TabTransitioning = false
end

