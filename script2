invisibleBtn.MouseButton1Click:Connect(function()
	cheats.Invisible = not cheats.Invisible
	updateToggleVisual(invisibleBtn, cheats.Invisible, "Invisible")
	
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local cam = workspace.CurrentCamera
	
	if cheats.Invisible then
		cheats.InfJump = false
		updateToggleVisual(infJumpBtn, false, "Infinite Jump")
		cheats.LoopTp = false
		updateToggleVisual(loopTpBtn, false, "Loop Teleport")
		
		if hum then stopFlying(hum) end
		
		if hrp and hum then
			invisPlatform = Instance.new("Part")
			invisPlatform.Size = Vector3.new(30, 2, 30)
			invisPlatform.Position = hrp.Position + Vector3.new(0, 10000, 0)
			invisPlatform.Anchored = true
			invisPlatform.Transparency = 1
			invisPlatform.Parent = workspace
			
			local startPos = hrp.CFrame
			hrp.CFrame = invisPlatform.CFrame + Vector3.new(0, 5, 0)
			
			fakeBox = Instance.new("Part")
			fakeBox.Name = "Invisible_FakeBox_" .. LocalPlayer.Name
			fakeBox.Size = Vector3.new(2, 4, 2)
			fakeBox.CFrame = startPos
			fakeBox.Color = Color3.fromRGB(0, 170, 255)
			fakeBox.Material = Enum.Material.Neon
			fakeBox.Transparency = 0.4
			fakeBox.CanCollide = not cheats.Noclip
			fakeBox.Anchored = true
			fakeBox.Parent = workspace
			
			camYaw = 0
			camPitch = 0
			boxYVelocity = 0
			isBoxGrounded = true
			
			cam.CameraType = Enum.CameraType.Scriptable
			
			inputConnection = UserInputService.InputChanged:Connect(function(input, gpe)
				if gpe then return end
				if cheats.Invisible and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local delta = input.Delta
					camYaw = camYaw - delta.X * 0.005
					camPitch = math.clamp(camPitch - delta.Y * 0.005, math.rad(-75), math.rad(75))
				end
			end)
			
			cameraConnection = RunService.RenderStepped:Connect(function(dt)
				if cheats.Invisible and fakeBox then
					fakeBox.CanCollide = not cheats.Noclip
					
					local camRot = CFrame.Angles(0, camYaw, 0) * CFrame.Angles(camPitch, 0, 0)
					local moveDir = hum.MoveDirection
					
					if moveDir.Magnitude > 0 then
						local camYawOnly = CFrame.Angles(0, camYaw, 0)
						local localMove = camYawOnly:VectorToObjectSpace(moveDir)
						local move3D
						
						if cheats.Fly then
							move3D = (camRot.RightVector * localMove.X) + (camRot.LookVector * (-localMove.Z))
						else
							move3D = Vector3.new(moveDir.X, 0, moveDir.Z)
						end
						
						if move3D.Magnitude > 0 then
							move3D = move3D.Unit
						end
						
						local currentSpeed = cheats.Fly and cheats.FlySpeed or cheats.WalkSpeed
						fakeBox.Position = fakeBox.Position + (move3D * currentSpeed * dt)
					end
					
					if cheats.Fly then
						boxYVelocity = 0
					else
						if not isBoxGrounded then
							boxYVelocity = boxYVelocity - (workspace.Gravity * dt)
							fakeBox.Position = fakeBox.Position + Vector3.new(0, boxYVelocity * dt, 0)
						end
						
						local ray = RaycastParams.new()
						ray.FilterDescendantsInstances = {fakeBox, char}
						ray.FilterType = Enum.RaycastFilterType.Exclude
						
						local rayResult = workspace:Raycast(fakeBox.Position, Vector3.new(0, -2.1, 0), ray)
						if rayResult then
							isBoxGrounded = true
							boxYVelocity = 0
							fakeBox.Position = Vector3.new(fakeBox.Position.X, rayResult.Position.Y + 2, fakeBox.Position.Z)
						else
							isBoxGrounded = false
						end
					end
					
					local camOffset = camRot:VectorToWorldSpace(Vector3.new(0, 3, 10))
					cam.CFrame = CFrame.new(fakeBox.Position + camOffset, fakeBox.Position + Vector3.new(0, 1.5, 0))
				end
			end)
		end
		
	else
		if cameraConnection then cameraConnection:Disconnect() cameraConnection = nil end
		if inputConnection then inputConnection:Disconnect() inputConnection = nil end
		
		local targetCFrame = fakeBox and fakeBox.CFrame
		if fakeBox then
			fakeBox:Destroy()
			fakeBox = nil
		end
		
		if invisPlatform then
			invisPlatform:Destroy()
			invisPlatform = nil
		end
		
		cam.CameraType = Enum.CameraType.Custom
		
		if hrp and targetCFrame then
			hrp.CFrame = targetCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			
			task.spawn(function()
				task.wait(0.1)
				if hrp and hrp.Parent then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
					
					local rayParams = RaycastParams.new()
					rayParams.FilterDescendantsInstances = {char}
					rayParams.FilterType = Enum.RaycastFilterType.Exclude
					
					local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), rayParams)
					if rayResult then
						hrp.CFrame = CFrame.new(rayResult.Position + Vector3.new(0, 3, 0))
					end
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		end
		
		if hum then
			cam.CameraSubject = hum
			if cheats.Fly and hrp then
				startFlying(hrp, hum)
			else
				hum.WalkSpeed = cheats.WalkSpeed
			end
		end
	end
end)

