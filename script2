UserInputService.JumpRequest:Connect(function()
	if cheats.InfJump and not cheats.Invisible then
		local char = LocalPlayer.Character
		if char and char:FindFirstChildOfClass("Humanoid") then
			char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	
	if cheats.Invisible and fakeBox and isBoxGrounded and not cheats.Fly then
		boxYVelocity = 50
		isBoxGrounded = false
	end
end)

RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and not cheats.Fly and hum.WalkSpeed ~= cheats.WalkSpeed then
		hum.WalkSpeed = cheats.WalkSpeed
	end
	
	if cheats.Noclip and not cheats.Invisible then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
	
	if cheats.Fly and not cheats.Invisible then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local cam = workspace.CurrentCamera
		
		if hrp and hum and cam then
			bodyGyro.CFrame = cam.CFrame
			
			local moveVector = hum.MoveDirection
			if moveVector.Magnitude > 0 then
				local camLook = cam.CFrame.LookVector
				local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
				local camYawOnly = flatLook.Magnitude > 0 and CFrame.lookAt(Vector3.zero, flatLook) or CFrame.identity
				
				local localMove = camYawOnly:VectorToObjectSpace(moveVector)
				local flyDir = (cam.CFrame.RightVector * localMove.X) + (cam.CFrame.LookVector * (-localMove.Z))
				if flyDir.Magnitude > 0 then flyDir = flyDir.Unit end
				
				bodyVelocity.Velocity = flyDir * cheats.FlySpeed
			else
				bodyVelocity.Velocity = Vector3.new(0, 0, 0)
			end
		end
	end
end)
