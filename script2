local function switchTab(toTeleport)
	if toTeleport then
		TweenService:Create(playerTabBtn, TweenInfo.new(0.25), {BackgroundTransparency = 0.6, TextColor3 = Color3.fromRGB(180, 180, 180)}):Play()
		TweenService:Create(teleportTabBtn, TweenInfo.new(0.25), {BackgroundTransparency = 0.3, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		
		playerPage.Visible = true
		teleportPage.Visible = true
		
		TweenService:Create(playerPage, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(-1, 0, 0, 0)}):Play()
		local tpTween = TweenService:Create(teleportPage, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
		tpTween:Play()
		tpTween.Completed:Connect(function() playerPage.Visible = false end)
	else
		TweenService:Create(teleportTabBtn, TweenInfo.new(0.25), {BackgroundTransparency = 0.6, TextColor3 = Color3.fromRGB(180, 180, 180)}):Play()
		TweenService:Create(playerTabBtn, TweenInfo.new(0.25), {BackgroundTransparency = 0.3, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		
		playerPage.Visible = true
		teleportPage.Visible = true
		
		TweenService:Create(teleportPage, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, 0, 0, 0)}):Play()
		local plTween = TweenService:Create(playerPage, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
		plTween:Play()
		plTween.Completed:Connect(function() teleportPage.Visible = false end)
	end
end

