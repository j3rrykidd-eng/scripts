local function updatePlayerDropdown()
	for _, child in ipairs(dropdownContainer:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			count = count + 1
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, -10, 0, 28)
			pBtn.BackgroundColor3 = Color3.fromRGB(25, 10, 10)
			pBtn.BackgroundTransparency = 0.4
			pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
			pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
			pBtn.TextSize = 11
			pBtn.Font = Enum.Font.Gotham
			pBtn.Parent = dropdownContainer
			createCorner(pBtn, 6)
			
			pBtn.MouseButton1Click:Connect(function()
				selectedTargetPlayer = p
				dropdownBtn.Text = "Ziel: " .. p.DisplayName .. " ▲"
				isDropdownOpen = false
				TweenService:Create(dropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, -6, 0, 35)
				}):Play()
			end)
		end
	end
	
	return count
end

dropdownBtn.MouseButton1Click:Connect(function()
	isDropdownOpen = not isDropdownOpen
	if isDropdownOpen then
		local pCount = updatePlayerDropdown()
		dropdownBtn.Text = "Spieler auswählen ▲"
		local targetHeight = math.min(35 + (pCount * 32), 160)
		TweenService:Create(dropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, -6, 0, targetHeight)
		}):Play()
	else
		dropdownBtn.Text = (selectedTargetPlayer and ("Ziel: " .. selectedTargetPlayer.DisplayName) or "Spieler auswählen") .. " ▼"
		TweenService:Create(dropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, -6, 0, 35)
		}):Play()
	end
end)

